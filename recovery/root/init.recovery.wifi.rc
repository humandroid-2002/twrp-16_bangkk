# OrangeFox WLAN for QCA6490 (sm84xx / mondrian)
#
# IMPORTANT: nothing here runs at boot. The cnss2 / qca_cld3 modules are loaded
# by the OrangeFox module loader and then sit idle ("deferred for calibration").
#
# When the user taps "Start WLAN", OrangeFox sets sys.fox.wlan.up=1 (see
# Wlan::StartInitSupplicantService). That fires the on-block below, which brings
# up the WLAN driver on demand and then starts the real wpa_supplicant service.
# Doing the bring-up on demand instead of during init keeps it off the
# boot-critical path so it can never stall/reboot recovery.
#
# This used to be a /system/bin/sh wrapper (mondrian_wlan_up.sh). It is now
# native init builtins: `wait` replaces the poll loop and ${ro.boot.slot_suffix}
# replaces getprop. Two things the shell version did cannot be expressed in
# init's language, but neither is needed here:
#   - the "skip if wlan0 already up" guard: StartInitSupplicantService already
#     returns early when the service is running, so this block won't re-run.
#   - the "skip /firmware mount if already mounted" guard: a redundant mount of
#     an already-mounted point simply fails harmlessly.

on property:post.decrypt.modules=true
    chmod 222 /sys/bus/platform/drivers/icnss2/22800000.qcom,icnss/wpss_boot
    write /sys/bus/platform/drivers/icnss2/22800000.qcom,icnss/wpss_boot 1
    wait /sys/class/net/wlan0 10
    write /dev/kmsg "Interface wlan0 found"
    setprop wifi.driver.ready true

on property:twrp.modules.loaded=true
    ######## Add by jason
    # WiFi early-init 阶段 加载内核模块
    # 使用 write 命令直接写入 /dev/kmsg，避免 SELinux 问题
    write /dev/kmsg "[jasonwifi][early-init] WiFi early-init started"
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    write /dev/kmsg "[jasonwifi][early-init] Starting modules load..."

# WiFi相关服务
service vendor.qrtr-ns /vendor/bin/qrtr-ns -f
    disabled
    user root
    group root
    capabilities NET_BIND_SERVICE
    seclabel u:r:recovery:s0

service vendor.rmt_storage /vendor/bin/rmt_storage
    disabled
    user root
    ioprio rt 0
    seclabel u:r:recovery:s0

service vendor.tftp_server /vendor/bin/tftp_server
    disabled
    user root
    seclabel u:r:recovery:s0
    disabled

service vendor.per_mgr /vendor/bin/pm-service
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service vendor.pd_mapper /vendor/bin/pd-mapper
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service vendor.per_proxy /vendor/bin/pm-proxy
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service cnss-daemon /vendor/bin/cnss-daemon -n -l
    disabled
    user root
    group root system inet net_admin wifi
    capabilities NET_ADMIN
    seclabel u:r:recovery:s0

service dhcpcd /system/bin/dhcpcd wlan0 -B
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:survival.start.service=true
    write /dev/kmsg "[jasonwifi][service] Starting Qualcomm services"
    start vendor.pd_mapper
    start cnss-daemon
    write /dev/kmsg "[jasonwifi][service] vendor.pd_mapper started"
    start vendor.per_proxy
    write /dev/kmsg "[jasonwifi][service] vendor.per_proxy started"
    start vendor.per_mgr
    write /dev/kmsg "[jasonwifi][service] vendor.per_mgr started"
    start vendor.qrtr-ns
    write /dev/kmsg "[jasonwifi][service] vendor.qrtr-ns started"
    start vendor.rmt_storage
    write /dev/kmsg "[jasonwifi][service] vendor.rmt_storage started"
    start vendor.tftp_server
    start vendor.wifi_hal_legacy
    write /dev/kmsg "[jasonwifi][service] vendor.tftp_server started"
    write /dev/kmsg "[jasonwifi][service] Qualcomm services started successfuly!"

on property:twrp.cpko=true
    wait /tmp/lib/modules/touchscreen_mmi.ko
    insmod /tmp/lib/modules/touchscreen_mmi.ko
    wait /tmp/lib/modules/mmi_relay.ko
    insmod /tmp/lib/modules/mmi_relay.ko
    wait /tmp/lib/modules/sensors_class.ko
    insmod /tmp/lib/modules/sensors_class.ko
    wait /tmp/lib/modules/mmi_annotate.ko
    insmod /tmp/lib/modules/mmi_annotate.ko
    wait /tmp/lib/modules/mmi_info.ko
    insmod /tmp/lib/modules/mmi_info.ko
    wait /tmp/lib/modules/focaltech_v3.ko
    insmod /tmp/lib/modules/focaltech_v3.ko
    wait /tmp/lib/modules/goodix_brl_mmi.ko
    insmod /tmp/lib/modules/goodix_brl_mmi.ko

    wait /tmp/lib/modules/lzo_decompress.ko
    insmod /tmp/lib/modules/lzo_decompress.ko
    wait /tmp/lib/modules/lzo_compress.ko
    insmod /tmp/lib/modules/lzo_compress.ko
    wait /tmp/lib/modules/lzo.ko
    insmod /tmp/lib/modules/lzo.ko
    wait /tmp/lib/modules/lzo-rle.ko
    insmod /tmp/lib/modules/lzo-rle.ko

    wait /tmp/lib/modules/q6_pdr_dlkm.ko
    insmod /tmp/lib/modules/q6_pdr_dlkm.ko
    wait /tmp/lib/modules/q6_notifier_dlkm.ko
    insmod /tmp/lib/modules/q6_notifier_dlkm.ko
    wait /tmp/lib/modules/snd_event_dlkm.ko
    insmod /tmp/lib/modules/snd_event_dlkm.ko
    wait /tmp/lib/modules/apr_dlkm.ko
    insmod /tmp/lib/modules/apr_dlkm.ko
    wait /tmp/lib/modules/q6_dlkm.ko
    insmod /tmp/lib/modules/q6_dlkm.ko

    wait /tmp/lib/modules/wcd_core_dlkm.ko
    insmod /tmp/lib/modules/wcd_core_dlkm.ko
    wait /tmp/lib/modules/wcd9xxx_dlkm.ko
    insmod /tmp/lib/modules/wcd9xxx_dlkm.ko
    wait /tmp/lib/modules/mbhc_dlkm.ko
    insmod /tmp/lib/modules/mbhc_dlkm.ko
    wait /tmp/lib/modules/swr_dlkm.ko
    insmod /tmp/lib/modules/swr_dlkm.ko
    wait /tmp/lib/modules/bolero_cdc_dlkm.ko
    insmod /tmp/lib/modules/bolero_cdc_dlkm.ko
    wait /tmp/lib/modules/wcd937x_dlkm.ko
    insmod /tmp/lib/modules/wcd937x_dlkm.ko
    wait /tmp/lib/modules/wcd938x_dlkm.ko
    insmod /tmp/lib/modules/wcd938x_dlkm.ko
    wait /tmp/lib/modules/aw87xxx_dlkm.ko
    insmod /tmp/lib/modules/aw87xxx_dlkm.ko
    wait /tmp/lib/modules/machine_dlkm.ko
    insmod /tmp/lib/modules/machine_dlkm.ko
    wait /tmp/lib/modules/platform_dlkm.ko
    insmod /tmp/lib/modules/platform_dlkm.ko
    wait /tmp/lib/modules/native_dlkm.ko
    insmod /tmp/lib/modules/native_dlkm.ko

    wait /tmp/lib/modules/swr_ctrl_dlkm.ko
    insmod /tmp/lib/modules/swr_ctrl_dlkm.ko
    wait /tmp/lib/modules/rx_macro_dlkm.ko
    insmod /tmp/lib/modules/rx_macro_dlkm.ko
    wait /tmp/lib/modules/va_macro_dlkm.ko
    insmod /tmp/lib/modules/va_macro_dlkm.ko
    wait /tmp/lib/modules/tx_macro_dlkm.ko
    insmod /tmp/lib/modules/tx_macro_dlkm.ko
    wait /tmp/lib/modules/wsa881x_analog_dlkm.ko
    insmod /tmp/lib/modules/wsa881x_analog_dlkm.ko
    wait /tmp/lib/modules/wcd937x_slave_dlkm.ko
    insmod /tmp/lib/modules/wcd937x_slave_dlkm.ko
    wait /tmp/lib/modules/wcd938x_slave_dlkm.ko
    insmod /tmp/lib/modules/wcd938x_slave_dlkm.ko
    wait /tmp/lib/modules/aw882xx_acf.ko
    insmod /tmp/lib/modules/aw882xx_acf.ko
    wait /tmp/lib/modules/aw882xx_k419.ko
    insmod /tmp/lib/modules/aw882xx_k419.ko

    wait /tmp/lib/modules/bq25980_mmi_iio.ko
    insmod /tmp/lib/modules/bq25980_mmi_iio.ko
    wait /tmp/lib/modules/mmi_parallel_charger_iio.ko
    insmod /tmp/lib/modules/mmi_parallel_charger_iio.ko
    wait /tmp/lib/modules/mmi-smbcharger-iio.ko
    insmod /tmp/lib/modules/mmi-smbcharger-iio.ko
    wait /tmp/lib/modules/awinic_sar.ko
    insmod /tmp/lib/modules/awinic_sar.ko
    wait /tmp/lib/modules/sx937x_sar.ko
    insmod /tmp/lib/modules/sx937x_sar.ko
    wait /tmp/lib/modules/mmi_sys_temp.ko
    insmod /tmp/lib/modules/mmi_sys_temp.ko
    wait /tmp/lib/modules/fm_ctrl.ko
    insmod /tmp/lib/modules/fm_ctrl.ko

    wait /tmp/lib/modules/camera.ko
    insmod /tmp/lib/modules/camera.ko
    wait /tmp/lib/modules/cci_intf.ko
    insmod /tmp/lib/modules/cci_intf.ko

    wait /tmp/lib/modules/stub_dlkm.ko
    insmod /tmp/lib/modules/stub_dlkm.ko
    wait /tmp/lib/modules/rmnet_ctl.ko
    insmod /tmp/lib/modules/rmnet_ctl.ko
    wait /tmp/lib/modules/rdbg.ko
    insmod /tmp/lib/modules/rdbg.ko
    wait /tmp/lib/modules/rmnet_core.ko
    insmod /tmp/lib/modules/rmnet_core.ko
    wait /tmp/lib/modules/rmnet_offload.ko
    insmod /tmp/lib/modules/rmnet_offload.ko
    wait /tmp/lib/modules/rmnet_shs.ko
    insmod /tmp/lib/modules/rmnet_shs.ko
    wait /tmp/lib/modules/pinctrl_lpi_dlkm.ko
    insmod /tmp/lib/modules/pinctrl_lpi_dlkm.ko

    wait /tmp/lib/modules/btpower.ko
    insmod /tmp/lib/modules/btpower.ko
    wait /tmp/lib/modules/bt_fm_slim.ko
    insmod /tmp/lib/modules/bt_fm_slim.ko
    wait /tmp/lib/modules/utags.ko
    insmod /tmp/lib/modules/utags.ko
    wait /tmp/lib/modules/rbs_fod_mmi.ko
    insmod /tmp/lib/modules/rbs_fod_mmi.ko
    wait /tmp/lib/modules/qpnp_adaptive_charge.ko
    insmod /tmp/lib/modules/qpnp_adaptive_charge.ko
    wait /tmp/lib/modules/ldo_vibrator_mmi.ko
    insmod /tmp/lib/modules/ldo_vibrator_mmi.ko
    wait /tmp/lib/modules/zram.ko
    insmod /tmp/lib/modules/zram.ko
    wait /tmp/lib/modules/exfat.ko
    insmod /tmp/lib/modules/exfat.ko
    wait /tmp/lib/modules/sec_nfc.ko
    insmod /tmp/lib/modules/sec_nfc.ko
    wait /tmp/lib/modules/wlan.ko
    insmod /tmp/lib/modules/wlan.ko

    write /dev/kmsg "[jasonwifi][early-init] WiFi early-init modules loaded successfully!"
    setprop twrp.insmodko 1
    ######## Add End

on property:post.decrypt.modules=true
    setprop sys.fox.wlan.up 0
    write /dev/kmsg "[wlan] booting wpss"
    write /sys/kernel/icnss/wlan_en_delay 1000
    write /sys/kernel/icnss/wpss_boot 1
    start fox-wlan-ready

on property:wifi.driver.ready=true
    write /dev/kmsg "[wlan] readying wpa_supplicant"
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0777 root root
    start wpa_supplicant

on property:sys.fox.wlan.up=1
    # wpa_supplicant's Android ctrl_iface refuses a non-accessible control dir
    # and crash-loops, so force the socket dir world-accessible (init's
    # restrictive umask would otherwise leave it 0700).
    mkdir /tmp/recovery 0777
    mkdir /tmp/recovery/sockets 0777

    # Ensure the QCA6490 firmware is reachable (modem partition). Harmless if the
    # common init.recovery.qcom.rc already mounted it.
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro

    # Point the direct firmware loader at our config dir (also a ueventd dir).
    write /sys/module/firmware_class/parameters/path /etc/firmware

    # Assert fs_ready -> cnss2 cold-boots, host driver creates wlan0. Then wait
    # up to 15s for the interface (replaces the shell sleep loop).
    write /sys/kernel/cnss/fs_ready 1
    wait /sys/class/net/wlan0 15

    start wpa_supplicant

    # Reset so the next tap is a fresh 0->1 transition that re-fires this block.
    setprop sys.fox.wlan.up 0

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    seclabel u:r:recovery:s0

service fox-wlan-ready /system/bin/sh -c "until test -e /sys/class/net/wlan0; do sleep 1; done; setprop wifi.driver.ready true"
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
#
